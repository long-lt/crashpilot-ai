CRASHPILOT_ENV=development
CRASHPILOT_LOG_LEVEL=INFO
CRASHPILOT_PROJECTS_FILE=config/projects.yaml
# Crashlytics backend: firebase_cli (default) | api (gcloud ADC) | browser (Playwright)
CRASHPILOT_CRASHLYTICS_BACKEND=firebase_cli
CRASHPILOT_BROWSER_PROFILE=browser_profiles/firebase
CRASHPILOT_HEADLESS=false
